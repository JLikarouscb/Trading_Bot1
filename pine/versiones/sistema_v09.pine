// SISTEMA v09 · Estructura + entradas FVG en un solo script (cambios en docs/versiones.md)
//
// QUÉ HACE, EN ORDEN
//  1. Estructura en dos niveles (menor 5/1 y mayor 20/3), con zigzag como LuxAlgo.
//     Ruptura (MSS/BOS) = N cierres seguidos más allá del nivel (por defecto 2), opcionalmente
//     sin contar velas envolventes. El MSS mayor exige que la estructura menor ya haya girado.
//     Zigzag mayor VERDE = estructura mayor alcista, ROJO = bajista (sin fondo de color).
//     Cajas de killzones: Asia, Londres y 8:30–9:30 NY (alto/bajo de cada sesión).
//     v07: zigzag mayor dibujado con polilíneas (todo el historial, sin el límite de 500 líneas),
//     MSS mayores numerados (#n) y evaluados: ¿el giro avanzó 1:1 antes de perder su origen?
//     Tabla de calidad de MSS por sesión.
//     v09: estructura igual a v07 (se descartan las reglas de v08). Bias automático = estructura mayor.
//     Se opera en las killzones marcadas como "operar" (horarios editables), con cajas para todas,
//     cierre del trade al terminar su killzone y tabla de resultados por killzone.
//  2. Bias por día relativo: "Hoy", "Hoy −1", ... (días hábiles). La tabla de abajo muestra la fecha de cada fila.
//  3. Entrada: dentro de la ventana, a favor del bias, en un FVG formado dentro del último tramo del zigzag
//     mayor, con su punto medio en el retroceso >= 50 % del tramo. Una entrada por tramo.
//  4. Stop: máx./mín. de N velas desde la vela inicial del FVG hacia atrás. Tabla de RR 1–3 y 0 % del tramo.
// Zigzag y FVG con la lógica de "ICT Silver Bullet [LuxAlgo]" (código propio; original CC BY-NC-SA 4.0).
// Resultados BRUTOS: sin spread ni deslizamiento. Stop y objetivo en la misma vela = stop.

//@version=6
strategy("Sistema v09: estructura + FVG", overlay = true, max_polylines_count = 100, initial_capital = 10000, currency = currency.USD, pyramiding = 10, margin_long = 0.5, margin_short = 0.5, max_boxes_count = 200, max_lines_count = 500, max_labels_count = 500)

tz = "America/New_York"

// =====================================================================
// 1. BIAS
// =====================================================================
gB     = "1. Bias (lo das tú)"
biasIn = input.string("ESTRUCTURA", "Modo", options = ["ESTRUCTURA", "POR DÍA", "LONG", "SHORT", "OFF", "ORACULO"], group = gB, tooltip = "ESTRUCTURA: la dirección la da el zigzag mayor (verde = largos, rojo = cortos). No tienes que poner nada.\nPOR DÍA: usa las filas de abajo.\nLONG/SHORT: el mismo bias para todos los días del historial.\nORACULO: dirección real del día (solo para medir entradas).")
b0 = input.string("OFF", "Hoy", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b0")
b1 = input.string("OFF", "Hoy −1", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b0")
b2 = input.string("OFF", "Hoy −2", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b2")
b3 = input.string("OFF", "Hoy −3", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b2")
b4 = input.string("OFF", "Hoy −4", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b4")
b5 = input.string("OFF", "Hoy −5", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b4")
b6 = input.string("OFF", "Hoy −6", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b6")
b7 = input.string("OFF", "Hoy −7", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b6")
b8 = input.string("OFF", "Hoy −8", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b8")
b9 = input.string("OFF", "Hoy −9", options = ["LONG", "SHORT", "OFF"], group = gB, inline = "b8")

// =====================================================================
// 2. HORARIO
// =====================================================================
gH  = "2. Killzones (hora Nueva York) · caja / operar"
z1s = input.session("2000-2359", "Asia", group = gH, inline = "z1")
z1b = input.bool(true, "caja", group = gH, inline = "z1")
z1t = input.bool(true, "operar", group = gH, inline = "z1")
z2s = input.session("0200-0500", "Londres", group = gH, inline = "z2")
z2b = input.bool(true, "caja", group = gH, inline = "z2")
z2t = input.bool(true, "operar", group = gH, inline = "z2")
z3s = input.session("0830-0930", "NY 8:30", group = gH, inline = "z3")
z3b = input.bool(true, "caja", group = gH, inline = "z3")
z3t = input.bool(true, "operar", group = gH, inline = "z3")
z4s = input.session("0930-1200", "NY AM", group = gH, inline = "z4")
z4b = input.bool(true, "caja", group = gH, inline = "z4")
z4t = input.bool(true, "operar", group = gH, inline = "z4")
z5s = input.session("1200-1300", "Almuerzo", group = gH, inline = "z5")
z5b = input.bool(true, "caja", group = gH, inline = "z5")
z5t = input.bool(false, "operar", group = gH, inline = "z5")
z6s = input.session("1330-1600", "NY PM", group = gH, inline = "z6")
z6b = input.bool(true, "caja", group = gH, inline = "z6")
z6t = input.bool(false, "operar", group = gH, inline = "z6")
closeAtZone = input.bool(true, "Cerrar cada trade al terminar su killzone", group = gH)
eodSess     = input.session("1550-1600", "Cierre forzado del día", group = gH)

// =====================================================================
// 3. ESTRUCTURA
// =====================================================================
gS       = "3. Estructura"
mL       = input.int(5, "Menor: velas izq.", minval = 1, maxval = 50, group = gS, inline = "m", tooltip = "Un swing necesita N velas más bajas (o altas) a la izquierda y M a la derecha.")
mR       = input.int(1, "der.", minval = 1, maxval = 10, group = gS, inline = "m")
ML       = input.int(20, "Mayor: velas izq.", minval = 2, maxval = 100, group = gS, inline = "M")
MR       = input.int(3, "der.", minval = 1, maxval = 20, group = gS, inline = "M")
nConf    = input.int(2, "Cierres seguidos para confirmar ruptura", minval = 1, maxval = 5, group = gS)
noEngulf = input.bool(false, "Las velas envolventes no cuentan como cierre de ruptura", group = gS)
needMin  = input.bool(true, "El MSS mayor exige que la estructura menor ya haya girado", group = gS)
zzColMode = input.string("Por estructura", "Color del zigzag mayor", options = ["Por estructura", "Por dirección del tramo"], group = gS, tooltip = "Por estructura: verde mientras la estructura mayor es alcista, rojo si es bajista.\nPor dirección del tramo: verde los tramos que suben, rojo los que bajan.")
colUp     = input.color(color.green, "Alcista", group = gS, inline = "c")
colDn     = input.color(color.red, "Bajista", group = gS, inline = "c")
zzMinOn  = input.bool(true, "Dibujar zigzag menor", group = gS, inline = "z")
zzMayOn  = input.bool(true, "mayor", group = gS, inline = "z")
hlOn     = input.bool(true, "Etiquetas HH/HL/LH/LL", group = gS, inline = "t")
bosOn    = input.bool(false, "Marcar BOS", group = gS, inline = "t")
keepMay  = input.int(220, "Etiquetas HH/HL del zigzag mayor a conservar", minval = 20, maxval = 300, group = gS, tooltip = "El zigzag mayor ya se dibuja completo (polilíneas). Este número solo limita sus etiquetas: TradingView permite máximo 500 etiquetas por script.")
keepMin  = input.int(80, "Tramos del zigzag menor a dibujar", minval = 0, maxval = 200, group = gS)
keepEv   = input.int(50, "MSS/BOS a dibujar por nivel", minval = 10, maxval = 100, group = gS)

// =====================================================================
// 4. ENTRADA FVG
// =====================================================================
gE         = "4. Entrada FVG"
needTrend  = input.bool(true, "Solo si la estructura mayor coincide con el bias", group = gE)
fibMin     = input.float(0.5, "Retroceso mínimo (punto medio del FVG)", minval = 0.3, maxval = 0.9, step = 0.05, group = gE, tooltip = "0.5 = el FVG debe estar en la mitad 'cara' del tramo (premium en cortos, descuento en largos).")
minConf    = input.int(0, "Mínimo de niveles OTE dentro del FVG", minval = 0, maxval = 3, group = gE, tooltip = "Cuántos de 0.618 / 0.705 / 0.786 deben caer dentro del FVG. 0 = no se exige.")
sameCandle = input.bool(true, "Vela de entrada a favor del bias", group = gE)
maxDay     = input.int(3, "Máximo de entradas por día (0 = sin límite)", minval = 0, group = gE)

// =====================================================================
// 5. STOP Y OBJETIVO
// =====================================================================
gX      = "5. Stop y objetivo"
nStop   = input.int(3, "Velas para el stop (desde la vela inicial del FVG hacia atrás)", minval = 1, maxval = 10, group = gX)
stopPad = input.float(1.0, "Margen del stop (puntos)", minval = 0, group = gX)
tgtMode = input.string("R fija", "Objetivo de los trades reales", options = ["R fija", "0 % del tramo"], group = gX)
tgtR    = input.float(2.0, "R fija", minval = 0.5, step = 0.5, group = gX)
qty     = input.float(1.0, "Contratos por entrada", minval = 0.01, group = gX)
showFib = input.bool(true, "Dibujar Fibonacci del tramo activo", group = gX)

// =====================================================================
// FECHAS: día de trading (desde las 18:00 NY cuenta como el día siguiente)
// =====================================================================
dnum(int t) =>
    t2 = t + 6 * 3600000
    int(math.floor(timestamp(tz, year(t2, tz), month(t2, tz), dayofmonth(t2, tz), 12, 0) / 86400000))
isBiz(int d) =>
    w = (d + 4) % 7
    w >= 1 and w <= 5

curD  = dnum(time)
lastD = dnum(last_bar_time)
int off = na
if lastD - curD <= 25 and isBiz(curD)
    c = 0
    if lastD > curD
        for d = curD + 1 to lastD
            if isBiz(d)
                c += 1
    off := c

bdir(string b) =>
    b == "LONG" ? 1 : b == "SHORT" ? -1 : 0
perDay = na(off) ? 0 : off == 0 ? bdir(b0) : off == 1 ? bdir(b1) : off == 2 ? bdir(b2) : off == 3 ? bdir(b3) : off == 4 ? bdir(b4) : off == 5 ? bdir(b5) : off == 6 ? bdir(b6) : off == 7 ? bdir(b7) : off == 8 ? bdir(b8) : off == 9 ? bdir(b9) : 0

[dO, dC] = request.security(syminfo.tickerid, "D", [open, close], lookahead = barmerge.lookahead_on)
dayDir = dC > dO ? 1 : dC < dO ? -1 : 0
inZ(string ss) =>
    not na(time(timeframe.period, ss, tz))
in1 = inZ(z1s)
in2 = inZ(z2s)
in3 = inZ(z3s)
in4 = inZ(z4s)
in5 = inZ(z5s)
in6 = inZ(z6s)
zIdx  = (z1t and in1) ? 1 : (z2t and in2) ? 2 : (z3t and in3) ? 3 : (z4t and in4) ? 4 : (z5t and in5) ? 5 : (z6t and in6) ? 6 : 0
inWin = zIdx != 0
zEnd  = array.from(false, in1[1] and not in1, in2[1] and not in2, in3[1] and not in3, in4[1] and not in4, in5[1] and not in5, in6[1] and not in6)
inEod = not na(time(timeframe.period, eodSess, tz))
newDay = curD != curD[1]

// =====================================================================
// MOTOR DE ESTRUCTURA
// =====================================================================
type ZZ
    int[]   d
    int[]   x
    float[] y
    line[]  ln
    label[] lb
    line[]  ev
    label[] evl
    int     trend
    int     hiBrokenX
    int     loBrokenX
    int     refHx
    int     refLx
    int     cntUp
    int     cntDn
    bool    evNew
    int     evDir
    float   evLvl
    float   evOrg
    int     evN

newZZ() =>
    ZZ.new(array.new_int(), array.new_int(), array.new_float(), array.new_line(), array.new_label(), array.new_line(), array.new_label(), 0, na, na, na, na, 0, 0, false, 0, na, na, 0)

method tag(ZZ z) =>
    string t = ""
    if z.d.size() >= 3
        t := z.d.get(0) == 1 ? (z.y.get(0) > z.y.get(2) ? "HH" : "LH") : (z.y.get(0) < z.y.get(2) ? "LL" : "HL")
    t

method push(ZZ z, int d, int bx, float py, color c, string pre, bool draw, bool drawLbl, int keep) =>
    bool changed = false
    if z.d.size() == 0 or z.d.get(0) != d
        line l = na
        if draw and z.d.size() > 0
            l := line.new(z.x.get(0), z.y.get(0), bx, py, color = color.new(c, 25), width = 1)
        label b = na
        if drawLbl and hlOn
            b := label.new(bx, py, "", style = d == 1 ? label.style_label_down : label.style_label_up, color = color.new(c, 100), textcolor = c, size = size.tiny)
        z.d.unshift(d)
        z.x.unshift(bx)
        z.y.unshift(py)
        z.ln.unshift(l)
        z.lb.unshift(b)
        changed := true
        // Los datos solo necesitan los puntos recientes; los dibujos se conservan hasta "keep"
        if z.d.size() > 60
            z.d.pop()
            z.x.pop()
            z.y.pop()
        if z.ln.size() > keep
            line.delete(z.ln.pop())
            label.delete(z.lb.pop())
    else if (d == 1 and py > z.y.get(0)) or (d == -1 and py < z.y.get(0))
        z.x.set(0, bx)
        z.y.set(0, py)
        line l = z.ln.get(0)
        if not na(l)
            line.set_xy2(l, bx, py)
        label b = z.lb.get(0)
        if not na(b)
            label.set_xy(b, bx, py)
        changed := true
    if changed
        label b = z.lb.get(0)
        if not na(b)
            label.set_text(b, pre + z.tag())
    changed

method mark(ZZ z, int x1, float y, string txt, color c, bool up, bool solid) =>
    z.ev.unshift(line.new(x1, y, bar_index, y, color = c, style = solid ? line.style_solid : line.style_dashed, width = solid ? 2 : 1))
    z.evl.unshift(label.new(int(math.round((x1 + bar_index) / 2)), y, txt, style = up ? label.style_label_down : label.style_label_up, color = color.new(c, 100), textcolor = c, size = size.tiny))
    if z.ev.size() > keepEv
        line.delete(z.ev.pop())
        label.delete(z.evl.pop())
    true

bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

// Rupturas con N cierres seguidos. allowUp/allowDn bloquean el MSS (jerarquía menor -> mayor).
method breaks(ZZ z, color cU, color cD, string pre, bool allowUp, bool allowDn) =>
    if z.d.size() >= 3
        iH = z.d.get(0) == 1 ? 2 : 1
        iL = z.d.get(0) == -1 ? 2 : 1
        hy = z.y.get(iH)
        hx = z.x.get(iH)
        ly = z.y.get(iL)
        lx = z.x.get(iL)
        z.evNew := false
        if na(z.refHx) or hx != z.refHx
            z.refHx := hx
            z.cntUp := 0
        if na(z.refLx) or lx != z.refLx
            z.refLx := lx
            z.cntDn := 0
        if close > hy
            if not (noEngulf and bullEng)
                z.cntUp += 1
        else
            z.cntUp := 0
        if close < ly
            if not (noEngulf and bearEng)
                z.cntDn += 1
        else
            z.cntDn := 0
        if z.cntUp >= nConf and (na(z.hiBrokenX) or hx != z.hiBrokenX)
            isMss = z.trend < 1
            if not isMss or allowUp
                if isMss
                    z.evN   += 1
                    z.evNew := true
                    z.evDir := 1
                    z.evLvl := hy
                    z.evOrg := ly
                if isMss or bosOn
                    z.mark(hx, hy, pre + (isMss ? "MSS" + (pre != "" ? " #" + str.tostring(z.evN) : "") : "BOS"), cU, true, isMss)
                z.trend     := 1
                z.hiBrokenX := hx
        if z.cntDn >= nConf and (na(z.loBrokenX) or lx != z.loBrokenX)
            isMss = z.trend > -1
            if not isMss or allowDn
                if isMss
                    z.evN   += 1
                    z.evNew := true
                    z.evDir := -1
                    z.evLvl := ly
                    z.evOrg := hy
                if isMss or bosOn
                    z.mark(lx, ly, pre + (isMss ? "MSS" + (pre != "" ? " #" + str.tostring(z.evN) : "") : "BOS"), cD, false, isMss)
                z.trend     := -1
                z.loBrokenX := lx
    true

var ZZ zm = newZZ()
var ZZ zM = newZZ()

mph = ta.pivothigh(high, mL, mR)
mpl = ta.pivotlow(low, mL, mR)
Mph = ta.pivothigh(high, ML, MR)
Mpl = ta.pivotlow(low, ML, MR)

if not na(mph)
    zm.push(1, bar_index - mR, mph, color.blue, "", zzMinOn, zzMinOn, keepMin)
if not na(mpl)
    zm.push(-1, bar_index - mR, mpl, color.blue, "", zzMinOn, zzMinOn, keepMin)
zm.breaks(color.blue, color.blue, "", true, true)

trendColor(int t) =>
    t == 1 ? colUp : t == -1 ? colDn : color.gray
if not na(Mph)
    zM.push(1, bar_index - MR, Mph, zzColMode == "Por estructura" ? trendColor(zM.trend) : colUp, "M·", false, zzMayOn, keepMay)
if not na(Mpl)
    zM.push(-1, bar_index - MR, Mpl, zzColMode == "Por estructura" ? trendColor(zM.trend) : colDn, "M·", false, zzMayOn, keepMay)
zM.breaks(colUp, colDn, "M·", not needMin or zm.trend == 1, not needMin or zm.trend == -1)

dir = biasIn == "ESTRUCTURA" ? zM.trend : biasIn == "POR DÍA" ? perDay : biasIn == "LONG" ? 1 : biasIn == "SHORT" ? -1 : biasIn == "ORACULO" ? dayDir : 0

// ---------- Historial completo del zigzag mayor (para polilíneas) ----------
// Cada punto guarda la tendencia vigente cuando se formó; el último toma la tendencia actual.
var int[]   hX = array.new_int()
var float[] hY = array.new_float()
var int[]   hD = array.new_int()
var int[]   hT = array.new_int()
var int[]   hM = array.new_int()   // tiempo del punto (las polilíneas usan tiempo: el índice no puede ir más de 10,000 velas atrás)
if zM.d.size() > 0
    d0 = zM.d.get(0)
    if hD.size() == 0 or hD.last() != d0
        hX.push(zM.x.get(0))
        hM.push(time[MR])
        hY.push(zM.y.get(0))
        hD.push(d0)
        hT.push(zM.trend)
        if hX.size() > 9000
            hX.shift()
            hY.shift()
            hD.shift()
            hT.shift()
            hM.shift()
    else if hX.last() != zM.x.get(0)
        hX.set(hX.size() - 1, zM.x.get(0))
        hM.set(hM.size() - 1, time[MR])
        hY.set(hY.size() - 1, zM.y.get(0))
        hT.set(hT.size() - 1, zM.trend)

var polyline[] pls = array.new<polyline>()
if barstate.islast and zzMayOn and hX.size() >= 2
    for pl0 in pls
        polyline.delete(pl0)
    pls.clear()
    n    = hX.size()
    segC = array.new_int()
    for i = 1 to n - 1
        segC.push(zzColMode == "Por estructura" ? (i == n - 1 ? zM.trend : hT.get(i)) : (hY.get(i) > hY.get(i - 1) ? 1 : -1))
    // Agrupa tramos seguidos del mismo color en una sola polilínea (máx. 100)
    runs = 1
    if segC.size() > 1
        for i = 1 to segC.size() - 1
            if segC.get(i) != segC.get(i - 1)
                runs += 1
    skip = math.max(0, runs - 95)
    pts  = array.new<chart.point>()
    pts.push(chart.point.from_time(hM.get(0), hY.get(0)))
    runIdx = 0
    for i = 1 to n - 1
        pts.push(chart.point.from_time(hM.get(i), hY.get(i)))
        endRun = i == n - 1 or segC.get(i) != segC.get(i - 1)
        if endRun
            if runIdx >= skip
                pls.push(polyline.new(pts, xloc = xloc.bar_time, line_color = trendColor(segC.get(i - 1)), line_width = i == n - 1 ? 2 : 1))
            runIdx += 1
            pts := array.new<chart.point>()
            pts.push(chart.point.from_time(hM.get(i), hY.get(i)))

// Etiqueta del swing en curso con el color de la estructura actual
if zM.lb.size() > 0
    bcur = zM.lb.get(0)
    if not na(bcur)
        label.set_textcolor(bcur, trendColor(zM.trend))

// =====================================================================
// CALIDAD DE LOS MSS MAYORES
// Un MSS es "válido" si el precio avanza a su favor 1 vez la distancia entre el nivel roto
// y el origen del giro (1:1) ANTES de cerrar más allá del origen. "Falso" si cierra más allá
// del origen primero. "Abierto" si no ha pasado ninguna de las dos cosas.
// =====================================================================
gQ      = "7. Calidad de MSS"
qMult   = input.float(1.0, "Avance requerido (veces la distancia nivel–origen)", minval = 0.25, step = 0.25, group = gQ)
qTable  = input.bool(true, "Mostrar tabla de calidad por sesión", group = gQ)

sessName(int t) =>
    h  = hour(t, tz)
    mi = minute(t, tz)
    m  = h * 60 + mi
    m >= 20 * 60 ? 0 : m >= 2 * 60 and m < 5 * 60 ? 1 : m >= 8 * 60 + 30 and m < 9 * 60 + 30 ? 2 : m >= 9 * 60 + 30 and m < 12 * 60 ? 3 : m >= 12 * 60 and m < 16 * 60 ? 4 : 5

type Q
    int   d
    float lvl
    float org
    float tgt
    int   ses
    int   n
    label lb

var Q[]   qs   = array.new<Q>()
var int[] qN   = array.new_int(6, 0)
var int[] qOk  = array.new_int(6, 0)
var int[] qBad = array.new_int(6, 0)

if qs.size() > 0
    for i = qs.size() - 1 to 0
        q = qs.get(i)
        bad = q.d == 1 ? close < q.org : close > q.org
        ok  = q.d == 1 ? high >= q.tgt : low <= q.tgt
        if bad or ok
            if ok and not bad
                qOk.set(q.ses, qOk.get(q.ses) + 1)
            else
                qBad.set(q.ses, qBad.get(q.ses) + 1)
            qs.remove(i)

if zM.evNew
    dist = math.abs(zM.evLvl - zM.evOrg)
    qs.push(Q.new(zM.evDir, zM.evLvl, zM.evOrg, zM.evLvl + zM.evDir * qMult * dist, sessName(time), zM.evN, na))
    s0 = sessName(time)
    qN.set(s0, qN.get(s0) + 1)

// =====================================================================
// KILLZONES (cajas con el alto y bajo de cada sesión)
// =====================================================================

type KZ
    box   bx
    label lb
    float hi
    float lo
    int   x0

kzRun(KZ k, string s, bool on, string name, color c) =>
    inK = on and not na(time(timeframe.period, s, tz))
    if inK and not inK[1]
        k.x0 := bar_index
        k.hi := high
        k.lo := low
        k.bx := box.new(bar_index, high, bar_index, low, border_color = color.new(c, 20), border_style = line.style_dashed, bgcolor = color.new(c, 88))
        k.lb := label.new(bar_index, high, name, style = label.style_label_down, color = color.new(c, 100), textcolor = c, size = size.small)
    else if inK and not na(k.bx)
        k.hi := math.max(k.hi, high)
        k.lo := math.min(k.lo, low)
        box.set_right(k.bx, bar_index)
        box.set_top(k.bx, k.hi)
        box.set_bottom(k.bx, k.lo)
        label.set_xy(k.lb, int(math.round((k.x0 + bar_index) / 2)), k.hi)
    true

var KZ k1 = KZ.new(na, na, na, na, na)
var KZ k2 = KZ.new(na, na, na, na, na)
var KZ k3 = KZ.new(na, na, na, na, na)
var KZ k4 = KZ.new(na, na, na, na, na)
var KZ k5 = KZ.new(na, na, na, na, na)
var KZ k6 = KZ.new(na, na, na, na, na)
kzRun(k1, z1s, z1b, "Asia", color.fuchsia)
kzRun(k2, z2s, z2b, "London", color.blue)
kzRun(k3, z3s, z3b, "NY 8:30", color.orange)
kzRun(k4, z4s, z4b, "NY AM", color.teal)
kzRun(k5, z5s, z5b, "Almuerzo", color.gray)
kzRun(k6, z6s, z6b, "NY PM", color.purple)

// =====================================================================
// TRAMO ACTIVO A FAVOR DEL BIAS (zigzag mayor)
// =====================================================================
float legS  = na
float legE  = na
int   legSx = na
int   legEx = na
if dir != 0 and zM.d.size() >= 2
    iEnd = zM.d.get(0) == dir ? 0 : 1
    if iEnd + 1 < zM.d.size()
        legE  := zM.y.get(iEnd)
        legEx := zM.x.get(iEnd)
        legS  := zM.y.get(iEnd + 1)
        legSx := zM.x.get(iEnd + 1)

retr(float p) =>
    na(legS) or legS == legE ? na : (p - legE) / (legS - legE)
fibPx(float f) =>
    legE + f * (legS - legE)

// =====================================================================
// FVG
// =====================================================================
type F
    int   d
    float top
    float bot
    float stop
    int   bar
    bool  used

var F[] fvgs = array.new<F>()
hiN = ta.highest(high, nStop)
loN = ta.lowest(low, nStop)
if high < low[2]
    fvgs.push(F.new(-1, low[2], high, hiN[2] + stopPad, bar_index, false))
if low > high[2]
    fvgs.push(F.new(1, low, high[2], loN[2] - stopPad, bar_index, false))
if fvgs.size() > 200
    fvgs.shift()

// =====================================================================
// SIMULACIÓN DE RR
// =====================================================================
type Vt
    int     z
    int     d
    float   entry
    float   stop
    float   risk
    float[] tg
    int[]   st

var Vt[]    vts = array.new<Vt>()
var float[] rrs = array.from(1.0, 1.5, 2.0, 2.5, 3.0)
var int[]   cW  = array.new_int(6, 0)
var int[]   cL  = array.new_int(6, 0)
var int[]   cT  = array.new_int(6, 0)
var float[] sR  = array.new_float(6, 0)

if vts.size() > 0
    for i = vts.size() - 1 to 0
        v = vts.get(i)
        stopHit = v.d == 1 ? low <= v.stop : high >= v.stop
        openLeft = 0
        for j = 0 to 5
            if v.st.get(j) == 0
                t = v.tg.get(j)
                tgtHit = v.d == 1 ? high >= t : low <= t
                if stopHit
                    v.st.set(j, -1)
                    cL.set(j, cL.get(j) + 1)
                    sR.set(j, sR.get(j) - 1)
                else if tgtHit
                    v.st.set(j, 1)
                    cW.set(j, cW.get(j) + 1)
                    sR.set(j, sR.get(j) + (t - v.entry) * v.d / v.risk)
                else if inEod or (closeAtZone and zEnd.get(v.z))
                    v.st.set(j, 2)
                    cT.set(j, cT.get(j) + 1)
                    sR.set(j, sR.get(j) + (close - v.entry) * v.d / v.risk)
                else
                    openLeft += 1
        if openLeft == 0
            vts.remove(i)

// =====================================================================
// ENTRADA
// =====================================================================
var int[]    entZ    = array.new_int()
var float[]  entR    = array.new_float()
var string[] openIds = array.new_string()
var int[]    openZ   = array.new_int()
var int nEntries  = 0
var int dE        = 0
var int days      = 0
var int tradedLeg = na
if newDay
    dE   := 0
    days += 1

F     pick  = na
float pRisk = na
int   pConf = 0
float pRetr = na
legValid = not na(legS) and (dir == 1 ? close > legS : close < legS)
if inWin and dir != 0 and legValid and (na(tradedLeg) or tradedLeg != legSx) and (maxDay == 0 or dE < maxDay) and (not needTrend or zM.trend == dir) and not inEod
    for f in fvgs
        if f.d == dir and not f.used and f.bar - 2 >= legSx and f.bar <= legEx + MR
            r = retr((f.top + f.bot) / 2)
            if not na(r) and r >= fibMin and r < 1
                conf = 0
                for lv in array.from(0.618, 0.705, 0.786)
                    p = fibPx(lv)
                    if p >= f.bot and p <= f.top
                        conf += 1
                touch    = dir == 1 ? low < f.top and close > f.bot : high > f.bot and close < f.top
                candleOk = not sameCandle or (dir == 1 ? close > open : close < open)
                risk     = dir == 1 ? close - f.stop : f.stop - close
                if touch and candleOk and risk > 0 and conf >= minConf
                    if na(pick) or conf > pConf or (conf == pConf and r > pRetr)
                        pick  := f
                        pRisk := risk
                        pConf := conf
                        pRetr := r

if not na(pick)
    pick.used := true
    nEntries  += 1
    dE        += 1
    tradedLeg := legSx
    id       = "E" + str.tostring(nEntries)
    leg0     = legE
    tgtLegOk = dir == 1 ? leg0 > close : leg0 < close
    tgtReal  = tgtMode == "0 % del tramo" and tgtLegOk ? leg0 : close + dir * tgtR * pRisk
    strategy.entry(id, dir == 1 ? strategy.long : strategy.short, qty = qty, comment = (dir == 1 ? "Largo #" : "Corto #") + str.tostring(dE))
    entZ.push(zIdx)
    entR.push(pRisk)
    openIds.push(id)
    openZ.push(zIdx)
    strategy.exit("X" + id, from_entry = id, stop = pick.stop, limit = tgtReal, comment_loss = "Stop", comment_profit = "Objetivo")
    tg = array.new_float()
    st = array.new_int()
    for rr in rrs
        tg.push(close + dir * rr * pRisk)
        st.push(0)
    tg.push(leg0)
    st.push(tgtLegOk ? 0 : 3)
    vts.push(Vt.new(zIdx, dir, close, pick.stop, pRisk, tg, st))
    box.new(pick.bar - 2, pick.top, bar_index, pick.bot, border_color = color.new(dir == 1 ? color.teal : color.red, 30), bgcolor = color.new(dir == 1 ? color.teal : color.red, 82))
    label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "Largo " : "Corto ") + str.tostring(dE) + "\nRetroceso " + str.tostring(pRetr * 100, "#") + " %\nOTE " + str.tostring(pConf) + "/3", style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? color.teal : color.red, textcolor = color.white, size = size.small, tooltip = "Riesgo " + str.tostring(pRisk, "#.#") + " pts\nStop " + str.tostring(pick.stop, format.mintick) + "\n0 % del tramo " + str.tostring(leg0, format.mintick))
    alert((dir == 1 ? "LARGO " : "CORTO ") + syminfo.ticker + " a " + str.tostring(close, format.mintick) + " · stop " + str.tostring(pick.stop, format.mintick) + " · OTE " + str.tostring(pConf) + "/3", alert.freq_once_per_bar_close)

alertcondition(not na(pick) and dir == 1, "v04 largo", "Sistema v04: entrada LARGO en {{ticker}} a {{close}}")
alertcondition(not na(pick) and dir == -1, "v04 corto", "Sistema v04: entrada CORTO en {{ticker}} a {{close}}")

if closeAtZone and openIds.size() > 0
    for i = openIds.size() - 1 to 0
        if zEnd.get(openZ.get(i))
            strategy.close(openIds.get(i), comment = "Fin killzone")
            openIds.remove(i)
            openZ.remove(i)
if inEod and strategy.position_size != 0
    strategy.close_all(comment = "Fin del día")
    openIds.clear()
    openZ.clear()

// Resultados reales por killzone (R de cada trade cerrado)
var int[]   kzN = array.new_int(7, 0)
var int[]   kzW = array.new_int(7, 0)
var float[] kzR = array.new_float(7, 0)
var int     lastClosed = 0
if strategy.closedtrades > lastClosed
    for i = lastClosed to strategy.closedtrades - 1
        eid = strategy.closedtrades.entry_id(i)
        nId = int(str.tonumber(str.substring(eid, 1)))
        if not na(nId) and nId >= 1 and nId <= entZ.size()
            zz = entZ.get(nId - 1)
            rk = entR.get(nId - 1)
            r  = (strategy.closedtrades.exit_price(i) - strategy.closedtrades.entry_price(i)) * math.sign(strategy.closedtrades.size(i)) / rk
            kzN.set(zz, kzN.get(zz) + 1)
            kzR.set(zz, kzR.get(zz) + r)
            if r > 0
                kzW.set(zz, kzW.get(zz) + 1)
    lastClosed := strategy.closedtrades

// =====================================================================
// FIBONACCI DEL TRAMO ACTIVO
// =====================================================================
var line[]  fl  = array.new_line()
var label[] fla = array.new_label()
var float[] fLv = array.from(0.0, 0.5, 0.618, 0.705, 0.786, 1.0)
if barstate.islast
    if fl.size() == 0
        for i = 0 to 5
            fl.push(line.new(bar_index, close, bar_index, close, color = color.gray, style = line.style_dotted))
            fla.push(label.new(bar_index, close, "", style = label.style_none, textcolor = color.gray, size = size.tiny))
    for i = 0 to 5
        lv = fLv.get(i)
        ln = fl.get(i)
        lb = fla.get(i)
        if showFib and not na(legS) and dir != 0
            p = fibPx(lv)
            c = lv == 0.5 ? color.gray : lv > 0.5 and lv < 1 ? color.red : color.silver
            line.set_xy1(ln, legSx, p)
            line.set_xy2(ln, bar_index + 10, p)
            line.set_color(ln, c)
            label.set_xy(lb, bar_index + 10, p)
            label.set_text(lb, str.tostring(lv, "#.###") + " (" + str.tostring(p, format.mintick) + ")")
            label.set_textcolor(lb, c)
        else
            line.set_xy1(ln, bar_index, close)
            line.set_xy2(ln, bar_index, close)
            label.set_text(lb, "")

// =====================================================================
// TABLAS
// =====================================================================
var table tb = table.new(position.top_right, 7, 9, bgcolor = color.new(color.black, 15), border_width = 1)
cell(int c, int r, string t, color col) =>
    table.cell(tb, c, r, t, text_color = col, text_size = size.small)

trendTxt(int t) =>
    t == 1 ? "ALCISTA" : t == -1 ? "BAJISTA" : "-"
trendCol(int t) =>
    t == 1 ? colUp : t == -1 ? colDn : color.gray

if barstate.islast
    cell(0, 0, "Objetivo", color.white)
    cell(1, 0, "Ganan", color.white)
    cell(2, 0, "Pierden", color.white)
    cell(3, 0, "Por hora", color.white)
    cell(4, 0, "% acierto", color.white)
    cell(5, 0, "R total", color.white)
    cell(6, 0, "R prom.", color.white)
    for j = 0 to 5
        nm = j < 5 ? str.tostring(rrs.get(j), "#.#") + " R" : "0 % tramo"
        w  = cW.get(j)
        l  = cL.get(j)
        t  = cT.get(j)
        n  = w + l + t
        cell(0, j + 1, nm, color.white)
        cell(1, j + 1, str.tostring(w), color.white)
        cell(2, j + 1, str.tostring(l), color.white)
        cell(3, j + 1, str.tostring(t), color.white)
        cell(4, j + 1, n > 0 ? str.tostring(100.0 * w / n, "#") + " %" : "-", color.white)
        cell(5, j + 1, str.tostring(sR.get(j), "#.#"), sR.get(j) >= 0 ? color.lime : color.red)
        cell(6, j + 1, n > 0 ? str.tostring(sR.get(j) / n, "#.##") : "-", color.white)
    cell(0, 7, "Estructura", color.gray)
    cell(1, 7, "menor", color.gray)
    cell(2, 7, trendTxt(zm.trend), trendCol(zm.trend))
    cell(3, 7, "mayor", color.gray)
    cell(4, 7, trendTxt(zM.trend), trendCol(zM.trend))
    cell(5, 7, str.tostring(nEntries) + " entradas", color.gray)
    cell(6, 7, str.tostring(days) + " días", color.gray)

// Tabla de fechas del bias
var table tbD = table.new(position.bottom_left, 3, 11, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast and biasIn == "POR DÍA"
    table.cell(tbD, 0, 0, "Fila", text_color = color.white, text_size = size.small)
    table.cell(tbD, 1, 0, "Fecha", text_color = color.white, text_size = size.small)
    table.cell(tbD, 2, 0, "Bias", text_color = color.white, text_size = size.small)
    d = lastD
    for r = 0 to 9
        while not isBiz(d)
            d -= 1
        bs = r == 0 ? b0 : r == 1 ? b1 : r == 2 ? b2 : r == 3 ? b3 : r == 4 ? b4 : r == 5 ? b5 : r == 6 ? b6 : r == 7 ? b7 : r == 8 ? b8 : b9
        table.cell(tbD, 0, r + 1, r == 0 ? "Hoy" : "Hoy −" + str.tostring(r), text_color = color.white, text_size = size.small)
        table.cell(tbD, 1, r + 1, str.format_time(d * 86400000, "EEE dd MMM", "UTC"), text_color = color.white, text_size = size.small)
        table.cell(tbD, 2, r + 1, bs, text_color = bs == "LONG" ? color.aqua : bs == "SHORT" ? color.red : color.gray, text_size = size.small)
        d -= 1

// Tabla de calidad de MSS mayores por sesión
var table tbQ = table.new(position.bottom_right, 5, 8, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast and qTable
    names = array.from("Asia 20-24", "Londres 2-5", "NY 8:30-9:30", "NY 9:30-12", "NY 12-16", "Otro horario")
    table.cell(tbQ, 0, 0, "MSS mayor", text_color = color.white, text_size = size.small)
    table.cell(tbQ, 1, 0, "Total", text_color = color.white, text_size = size.small)
    table.cell(tbQ, 2, 0, "Válidos", text_color = color.white, text_size = size.small)
    table.cell(tbQ, 3, 0, "Falsos", text_color = color.white, text_size = size.small)
    table.cell(tbQ, 4, 0, "% válido", text_color = color.white, text_size = size.small)
    tN = 0
    tO = 0
    tB = 0
    for i = 0 to 5
        a = qN.get(i)
        o = qOk.get(i)
        b = qBad.get(i)
        tN += a
        tO += o
        tB += b
        table.cell(tbQ, 0, i + 1, names.get(i), text_color = color.white, text_size = size.small)
        table.cell(tbQ, 1, i + 1, str.tostring(a), text_color = color.white, text_size = size.small)
        table.cell(tbQ, 2, i + 1, str.tostring(o), text_color = color.lime, text_size = size.small)
        table.cell(tbQ, 3, i + 1, str.tostring(b), text_color = color.red, text_size = size.small)
        table.cell(tbQ, 4, i + 1, o + b > 0 ? str.tostring(100.0 * o / (o + b), "#") + " %" : "-", text_color = color.white, text_size = size.small)
    table.cell(tbQ, 0, 7, "Total", text_color = color.yellow, text_size = size.small)
    table.cell(tbQ, 1, 7, str.tostring(tN), text_color = color.yellow, text_size = size.small)
    table.cell(tbQ, 2, 7, str.tostring(tO), text_color = color.yellow, text_size = size.small)
    table.cell(tbQ, 3, 7, str.tostring(tB), text_color = color.yellow, text_size = size.small)
    table.cell(tbQ, 4, 7, tO + tB > 0 ? str.tostring(100.0 * tO / (tO + tB), "#") + " %" : "-", text_color = color.yellow, text_size = size.small)

// Tabla de resultados reales por killzone (objetivo = el de "Stop y objetivo")
var table tbZ = table.new(position.middle_right, 5, 8, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    zn = array.from("-", "Asia", "Londres", "NY 8:30", "NY AM", "Almuerzo", "NY PM")
    zt = array.from(false, z1t, z2t, z3t, z4t, z5t, z6t)
    table.cell(tbZ, 0, 0, "Killzone", text_color = color.white, text_size = size.small)
    table.cell(tbZ, 1, 0, "Trades", text_color = color.white, text_size = size.small)
    table.cell(tbZ, 2, 0, "% gan.", text_color = color.white, text_size = size.small)
    table.cell(tbZ, 3, 0, "R total", text_color = color.white, text_size = size.small)
    table.cell(tbZ, 4, 0, "R prom.", text_color = color.white, text_size = size.small)
    for k = 1 to 6
        n = kzN.get(k)
        on = zt.get(k)
        table.cell(tbZ, 0, k, zn.get(k) + (on ? "" : " (off)"), text_color = on ? color.white : color.gray, text_size = size.small)
        table.cell(tbZ, 1, k, str.tostring(n), text_color = color.white, text_size = size.small)
        table.cell(tbZ, 2, k, n > 0 ? str.tostring(100.0 * kzW.get(k) / n, "#") + " %" : "-", text_color = color.white, text_size = size.small)
        table.cell(tbZ, 3, k, str.tostring(kzR.get(k), "#.#"), text_color = kzR.get(k) >= 0 ? color.lime : color.red, text_size = size.small)
        table.cell(tbZ, 4, k, n > 0 ? str.tostring(kzR.get(k) / n, "#.##") : "-", text_color = color.white, text_size = size.small)
    table.cell(tbZ, 0, 7, "Bias: " + biasIn, text_color = color.gray, text_size = size.small)
