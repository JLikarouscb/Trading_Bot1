# Copia este archivo como .env y llena los valores. .env nunca se sube a GitHub.

# cTrader Open API (se obtienen al registrar tu aplicación en el portal de Open API de cTrader)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
# demo o live. Empieza siempre en demo.
CTRADER_ENV=demo

# Telegram (control de respaldo desde la tablet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Panel Streamlit
PANEL_PASSWORD=
